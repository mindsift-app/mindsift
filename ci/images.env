# The container images of the scripts in ci/, desktop/ and e2e/ and of the workflows, in one place.
# Plain NAME=value lines: sourced by the shell scripts (. ci/images.env), read by the workflows.
# Every image is pinned to an exact release (no moving tags such as alpine:3 or node:26) that was out for
# at least 14 days when it was chosen (AGENTS.md). The Dockerfile cannot read this file: its FROM lines
# name the same Node, Go and Alpine, and ci/check-images.sh (in ci/local-checks.sh) fails when they drift.

# Frontend (tsc, ESLint, Vitest, vite build) and the frontend stage of the Dockerfile
NODE_IMAGE=docker.io/library/node:26.13.1-alpine
# Backend (go vet, go test), the Go stage of the Dockerfile, and the desktop module's checks
GO_IMAGE=docker.io/library/golang:1.27.4-alpine
# The desktop app's builds (Debian, for GTK 4 / WebKitGTK 6.0 and cgo): desktop/build.sh
GO_DESKTOP_IMAGE=docker.io/library/golang:1.27.4-trixie
# The final stage of the Dockerfile; the image tools of e2e/screenshots.sh and desktop/packaging/make-icons.sh
ALPINE_IMAGE=docker.io/library/alpine:3.24.4
# flatpak-builder (desktop/packaging/flatpak/build.sh) and NSIS (desktop/packaging/windows/build.sh)
DEBIAN_IMAGE=docker.io/library/debian:trixie-20261027-slim
# flatpak-node-generator (desktop/packaging/flatpak/update-sources.sh)
PYTHON_IMAGE=docker.io/library/python:3.14.9-alpine3.24
# The browser tests, screenshots and the video tour (e2e/)
PLAYWRIGHT_IMAGE=mcr.microsoft.com/playwright:v1.65.0-noble
# The OpenID Connect provider of the browser tests (e2e/run.sh)
DEX_IMAGE=ghcr.io/dexidp/dex:v2.44.0
# Linters: golangci-lint (ci/local-checks.sh, pr.yaml) and shellcheck (ci/local-checks.sh, part plan)
GOLANGCI_LINT_IMAGE=docker.io/golangci/golangci-lint:v2.15.0-alpine
SHELLCHECK_IMAGE=docker.io/koalaman/shellcheck-alpine:v0.11.0
# The security scan of the images (ci/trivy-scan.sh)
TRIVY_IMAGE=docker.io/aquasec/trivy:0.76.1
