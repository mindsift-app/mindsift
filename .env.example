# MindSift – settings
# Copy to .env (cp .env.example .env) and adjust; docker-compose.yml reads the values from there.
# Values left empty take the default from docker-compose.yml. After changes: docker compose up -d

# ─── Basics ────────────────────────────────────────────────────────────────────────────────────────

# Port on the host where MindSift can be reached (always 8080 inside the container).
PORT=8080

# Secret key for sign-in, at least 32 random characters, e.g. from: openssl rand -hex 32
# Well-known example values (like this one) are ignored; MindSift then creates one itself and keeps it in data/.
JWT_SECRET=change_this_to_a_secure_random_key_min_32_chars

# Key for hidden values in notes (/secret), any long random value, e.g. from: openssl rand -hex 32.
# Empty: MindSift creates one and keeps it in data/secrets.key. Set here, the key is not stored next to
# the database. Never change it once values are stored: with another key they can no longer be read.
SECRETS_KEY=

# Public address of the instance, as it is opened in the browser. Needed for links in emails
# (password reset) and limits which address live connections may come from.
BASE_URL=http://localhost:8080

# Time zone for due dates and alarms (default Europe/Berlin).
TZ=Europe/Berlin

# Default language (de, en, es, fr, it) for the sign-in page and new accounts, until the setup wizard or
# an admin picks one; everyone chooses their own language. Unset: German, in the demo English.
# DEFAULT_LANGUAGE=en

# Registration without an invitation. Unset leaves it to Administration → Server & Isolation;
# set, it is locked there:
#   closed           invitation only
#   approval         anyone may register, an admin approves
#   domain           only email addresses from REGISTRATION_DOMAINS, active right away
#   domain+approval  those domains right away, all others after approval
#   open             anyone, active right away
# REGISTRATION_MODE=approval
# REGISTRATION_DOMAINS=company.com, family.org
# New accounts without an invitation confirm their email address by link first (needs SMTP and BASE_URL):
# REGISTRATION_VERIFY_EMAIL=true
# Legacy: true is the same as REGISTRATION_MODE=open; false leaves the choice to the admin.
ALLOW_REGISTRATION=false

# Retention: may people choose "never", i.e. keep completed and deleted things for good?
# false = no (the area's default applies, e.g. 30 days), true = yes. Unset leaves it to
# Administration → Server & Isolation (default: allowed).
# RETENTION_ALLOW_NEVER=false

# ─── Security ──────────────────────────────────────────────────────────────────────────────────────

# Whose information about the visitor's address (X-Forwarded-For / X-Real-IP) is trusted. Important for
# the sign-in lock behind a reverse proxy.
#   private  proxies in the local network, Docker network or Tailscale (default, fits most setups)
#   none     trust no proxy – use this when MindSift's port is reachable without a proxy in front:
#            Docker may pass such connections on from 172.17.0.1, which "private" would trust
#            (Doku/reverse-proxy.md)
#   all      trust everyone (switches the check off)
#   list     your own addresses in addition, e.g. private,203.0.113.0/24 (Cloudflare and other external proxies)
TRUSTED_PROXIES=private

# Lock after failed sign-in attempts and limits for registration and "forgot password".
# false switches both off (only sensible if a service in front takes care of it).
LOGIN_PROTECTION=true

# ─── Logging ───────────────────────────────────────────────────────────────────────────────────────

# How detailed the container log is: debug, info, warn or error.
LOG_LEVEL=info
# true = detailed log of all requests and of the synchronization (like LOG_LEVEL=debug).
DEBUG=false

# ─── Demo ──────────────────────────────────────────────────────────────────────────────────────────

# true = public demo: creates the accounts admin/admin and user/user with sample data. The demo sends
# nothing (no mails, webhooks, alarms) and protects the shared accounts.
MINDSIFT_DEMO=false
# Demo only: reset to the sample data every this many minutes (0 = never).
DEMO_RESET_MINUTES=20

# ─── Email (optional) ──────────────────────────────────────────────────────────────────────────────
# For alarm mails and "forgot password". Can also be set in Administration → Email; values there take
# precedence.

# Mail server, e.g. smtp.example.com. Empty = no mail.
SMTP_HOST=
# 587 (STARTTLS) or 465 (TLS from the start of the connection).
SMTP_PORT=587
# Sign-in at the mail server; empty if the server does not require one.
SMTP_USER=
SMTP_PASS=
# Sender address, e.g. noreply@example.com. Empty = SMTP_USER or noreply@mindsift.local.
SMTP_FROM=
# Name mail programs show as the sender (when SMTP_FROM is only an address).
# A name right in SMTP_FROM ("My service <noreply@example.com>") takes precedence.
SMTP_FROM_NAME=MindSift
# Notifications (shares, watched tasks …) are collected and sent as one message at most every this many
# minutes. Due tasks always come right away.
NOTIFY_DIGEST_MINUTES=5
# true = send encrypted only.
SMTP_TLS=true
# true = accept self-signed certificates (only for internal mail servers).
SMTP_SKIP_VERIFY=false

# Web push (notifications on phone and desktop, even with the app closed).
# Unset, MindSift creates a key pair when first needed and stores it in the database.
# VAPID_SUBJECT: contact for the push services (mailto: or https://); defaults to BASE_URL if https.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@example.com

# ─── Legal notice and privacy policy (optional) ────────────────────────────────────────────────────
# Linked on the sign-in page and in the settings. Either as a link to an external page (http/https only)
# or as Markdown text, right here or as a file (mount it as a volume). Without values the links stay
# hidden.
LEGAL_IMPRINT_URL=
LEGAL_PRIVACY_URL=
LEGAL_IMPRINT_CONTENT=
LEGAL_PRIVACY_CONTENT=
# Path in the container, e.g. /legal/imprint.md
LEGAL_IMPRINT_CONTENT_FILE=
LEGAL_PRIVACY_CONTENT_FILE=
# Your own link in the footer (https:// only)
LEGAL_CUSTOM_LINK_LABEL=
LEGAL_CUSTOM_LINK_URL=

# ─── Images and audio in notes ─────────────────────────────────────────────────────────────────────
# Files live in data/media/ and are only visible to people who may read the note. MindSift cleans up
# files no longer in use after a day.

# Largest image in MB (the browser shrinks photos to at most 2048 pixels first).
MEDIA_MAX_IMAGE_MB=15
# Largest audio file in MB (voice note or uploaded file).
MEDIA_MAX_AUDIO_MB=50
# Media storage per person in MB; 0 = unlimited.
MEDIA_QUOTA_MB=0
# Demo only: largest file in MB (files disappear with the demo reset).
MEDIA_DEMO_MAX_MB=3

# ─── Speech recognition (optional) ─────────────────────────────────────────────────────────────────
# Without STT_URL, MindSift uses the browser's speech recognition (Chrome, Edge, Safari; the recording
# goes to Google, Microsoft or Apple). With your own Whisper server everything stays on your server and
# it works in every browser. Uncomment the "whisper" block in docker-compose.yml for that (instructions
# are there). Errors are in the log: docker compose logs mindsift whisper

# Address of the Whisper server (OpenAI-compatible, e.g. speaches). Set = server mode.
STT_URL=
# Model: deepdml/faster-whisper-large-v3-turbo-ct2 (best recognition, about 2 GB RAM, slower)
#        Systran/faster-whisper-small (about 1 GB RAM, much faster, small mistakes)
#        Others (also fine-tuned for one language): any Whisper model in CTranslate2 format, list at
#        https://huggingface.co/models?pipeline_tag=automatic-speech-recognition&library=ctranslate2&sort=downloads
STT_MODEL=deepdml/faster-whisper-large-v3-turbo-ct2
# Only if the Whisper server requires a key (for speaches: its API_KEY).
STT_API_KEY=
# true = hide the microphone everywhere, the browser recognition too.
STT_DISABLED=false
# false = the browser's speech recognition is forbidden (Chrome/Edge send the recording to Google or
# Microsoft). With a Whisper server the Whisper/browser choice in the account settings goes away;
# without a Whisper server there is no voice input then.
STT_ALLOW_BROWSER=true

# Limits for server mode
# Longest recording in seconds; the browser stops the recording by itself after that.
STT_MAX_SECONDS=600
# Largest recording in MB.
STT_MAX_UPLOAD_MB=25
# How many recognitions run at the same time; more wait in line. 1 spares weak CPUs.
STT_MAX_PARALLEL=1
# Recognitions per person and hour.
STT_PER_USER_PER_HOUR=60
# Longest a recognition may take in seconds, waiting in line included.
STT_TIMEOUT_SECONDS=120
# Asks the Whisper server to skip silence (fewer made-up repetitions); false if the server rejects the field.
STT_VAD_FILTER=true
