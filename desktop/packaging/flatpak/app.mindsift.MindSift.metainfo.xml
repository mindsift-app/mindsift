    <keyword>notes</keyword>
    <keyword>tasks</keyword>
    <keyword>lists</keyword>
    <keyword>outliner</keyword>
  </keywords>
  <releases>
    <release version="0.99.3" date="2026-11-24" type="stable">
      <description>
        <p>Realtime updates reach everyone who sees a list, note or group, access that ends also ends live updates, and screens, sheets and settings share one look with larger tap targets on phones.</p>
      </description>
      <url type="details">https://github.com/mindsift-app/mindsift/releases/tag/v0.99.3</url>
    </release>
    <release version="0.99.2" date="2026-11-23" type="stable">
      <description>
        <p>Escape and clicks beside menus close only what is on top, "Collapse all" folds only the level you see, and the desktop app asks before throwing away a recording.</p>
      </description>
      <url type="details">https://github.com/mindsift-app/mindsift/releases/tag/v0.99.2</url>
    </release>
    <release version="0.99.1" date="2026-11-23" type="stable">
      <description>
        <p>Background transcriptions retry by themselves, dictations are guarded against reloads and closing, and phone sheets share one look.</p>
      </description>
      <url type="details">https://github.com/mindsift-app/mindsift/releases/tag/v0.99.1</url>
    </release>
    <release version="0.99.0" date="2026-11-22" type="stable">
      <description>
        <p>Alarms as system notifications, downloads with a save dialog, voice notes that play properly, transcription in the background, complete backups with restore, and updates from the own Flatpak repository.</p>
      </description>
      <url type="details">https://github.com/mindsift-app/mindsift/releases/tag/v0.99.0</url>
    </release>
    <release version="0.98.0" date="2026-11-22" type="stable">
