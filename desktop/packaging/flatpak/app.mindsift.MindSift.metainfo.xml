    <screenshot>
      <caption>Tasks on a Kanban board</caption>
      <image>https://raw.githubusercontent.com/mindsift-app/mindsift/v0.99.3/screenshots/store/board.png</image>
    </screenshot>
    <screenshot>
      <caption>Tasks in the calendar</caption>
      <image>https://raw.githubusercontent.com/mindsift-app/mindsift/v0.99.3/screenshots/store/calendar.png</image>
    </screenshot>
    <screenshot>
      <caption>A journal for each day</caption>
      <image>https://raw.githubusercontent.com/mindsift-app/mindsift/v0.99.3/screenshots/store/journal.png</image>
